#!/bin/sh
# BigFoston OS Installer: roda direto do código (./installer/bigfoston-installer) ou instalado
# pelo pacote (/usr/bin/bigfoston-installer -> /usr/lib/bigfoston-installer).
# SPDX-License-Identifier: GPL-3.0-or-later
D=$(dirname "$(readlink -f "$0")")
[ -d "$D/bigfoston_installer" ] || D=/usr/lib/bigfoston-installer
PYTHONPATH="$D${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m bigfoston_installer "$@"
